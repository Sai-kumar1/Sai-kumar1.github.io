source "https://rubygems.org"

# Pins the same Jekyll version and plugins GitHub Pages uses
# (jekyll-seo-tag, jekyll-feed, jekyll-sitemap, jekyll-redirect-from…),
# so a local build matches the live site.
gem "github-pages", group: :jekyll_plugins

# Needed by `jekyll serve` on Ruby 3+
gem "webrick"
